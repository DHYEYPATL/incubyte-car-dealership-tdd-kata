# JWT Secret Key (required in production)
SECRET_KEY=generate_a_secure_random_key_here

# Optional: Comma-separated list of additional allowed CORS origins
# (Vercel domains *.vercel.app and localhost are allowed by default)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional: Auto-populate database with sample vehicles and demo accounts on startup
AUTO_SEED=true
